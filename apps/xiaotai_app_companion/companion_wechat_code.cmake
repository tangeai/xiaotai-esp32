set(XIAOTAI_COMPANION_WECHAT_CODE_SOURCE "${XIAOTAI_COMPANION_WECHAT_CODE_SOURCE}" CACHE STRING
    "Absolute path to authorized external companion MONO1 C source, empty to omit")
set(XIAOTAI_COMPANION_WECHAT_CODE_SHA256 "${XIAOTAI_COMPANION_WECHAT_CODE_SHA256}" CACHE STRING
    "SHA-256 of the authorized external companion MONO1 C source")

function(xiaotai_companion_wechat_code out selected repository)
    set(source "${XIAOTAI_COMPANION_WECHAT_CODE_SOURCE}")
    set(expected "${XIAOTAI_COMPANION_WECHAT_CODE_SHA256}")
    set(${out} "" PARENT_SCOPE)
    if(source STREQUAL "" AND expected STREQUAL "")
        return()
    endif()
    if(source STREQUAL "" OR expected STREQUAL "")
        message(FATAL_ERROR "Set both XIAOTAI_COMPANION_WECHAT_CODE_SOURCE and XIAOTAI_COMPANION_WECHAT_CODE_SHA256")
    endif()
    if(NOT xiaotai_ui IN_LIST selected)
        message(FATAL_ERROR "The external companion WeChat code requires xiaotai_ui")
    endif()

    string(LENGTH "${expected}" hash_length)
    if(NOT hash_length EQUAL 64 OR NOT expected MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "XIAOTAI_COMPANION_WECHAT_CODE_SHA256 must contain exactly 64 hexadecimal digits")
    endif()
    if(NOT IS_ABSOLUTE "${source}" OR NOT source MATCHES "\\.c$" OR source MATCHES "[;\r\n]|\\$<")
        message(FATAL_ERROR "XIAOTAI_COMPANION_WECHAT_CODE_SOURCE must be a single absolute .c path")
    endif()
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "XIAOTAI_COMPANION_WECHAT_CODE_SOURCE does not name an existing file")
    endif()

    get_filename_component(repository_real "${repository}" REALPATH)
    get_filename_component(source_abs "${source}" ABSOLUTE)
    get_filename_component(source_real "${source}" REALPATH)
    if(NOT source_real MATCHES "\\.c$")
        message(FATAL_ERROR "XIAOTAI_COMPANION_WECHAT_CODE_SOURCE must resolve to a .c file")
    endif()
    # Check both names so an in-tree symlink or a link into the tree cannot
    # bring in a packaged or legacy asset. Fold case for shared Windows disks.
    string(TOLOWER "${repository_real}" repository_folded)
    foreach(candidate IN ITEMS "${source_abs}" "${source_real}")
        string(TOLOWER "${candidate}" candidate_folded)
        file(RELATIVE_PATH relative "${repository_folded}" "${candidate_folded}")
        if(NOT IS_ABSOLUTE "${relative}" AND NOT relative MATCHES "^\\.\\.(/|$)")
            message(FATAL_ERROR "The authorized companion WeChat code source must be outside the repository")
        endif()
    endforeach()
    file(SHA256 "${source_real}" actual)
    string(TOLOWER "${expected}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "XIAOTAI_COMPANION_WECHAT_CODE_SOURCE SHA-256 mismatch")
    endif()

    # Compile the checked bytes, not a later revision of the external file.
    set(snapshot "${CMAKE_CURRENT_BINARY_DIR}/companion_wechat_code_asset.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_abs}")
    configure_file("${source_real}" "${snapshot}" COPYONLY)
    file(SHA256 "${snapshot}" snapshot_hash)
    if(NOT snapshot_hash STREQUAL expected)
        message(FATAL_ERROR "The authorized companion WeChat code changed during configuration")
    endif()
    set(${out} "${snapshot}" PARENT_SCOPE)
endfunction()
