{
  "schema": 1,
  "name": "xiaotai-wt9932p4c61-tiny",
  "board": "wt/wt9932p4c61-tiny",
  "applications": [
    "doorbell"
  ],
  "modules": [
    "contacts",
    "call",
    "video_call",
    "environment",
    "settings"
  ],
  "priorities": {
    "call": 1
  },
  "parameters": {
    "platform": {
      "discovery_url": "http://ep-open.tangeopen.com/services",
      "board_model": "@board.identity.profile_model",
      "chip_model": "@board.identity.profile_chip",
      "clock_probe": true,
      "idle_keep_ms": 3000,
      "subscribe_timeout_s": 30,
      "get_retry_on_reuse": true,
      "profile_retry_business_errors": true
    },
    "transport": {
      "links": 1,
      "accept_pcma_opus_downlink": true,
      "start_before_signaling": true,
      "start_reserve_bytes": 20480,
      "connect_reserve_bytes": 17408,
      "poll_timeout_ms": 20,
      "stack_log_level": 3,
      "unsolicited_stop": "XIAOTAI_TRANSPORT_RECOVER_FAULT",
      "fault_restart_ms": 5000,
      "release_failures_tolerated": true,
      "early_events_dropped": true,
      "media_transport": "XIAOTAI_TRANSPORT_ON",
      "media_transport_before_init": true
    },
    "binding": {
      "voice": "XIAOTAI_BINDING_VOICE_SERVER",
      "announce_rounds": 3,
      "announce_gap_ms": 350
    },
    "call": {
      "strict_failed_accept_room_id": true,
      "accept_peer_audio_stream": true
    },
    "net": {
      "history_capacity": 4,
      "block_retry_after_driver_start_failure": true
    },
    "doorbell": {
      "open_on_word": true
    },
    "media": {
      "playout.mixer": 1,
      "playout.pacer_policy": 0,
      "task.capture.priority": 8,
      "task.capture.core": 1,
      "task.uplink.priority": 8,
      "task.uplink.core": 1
    }
  },
  "options": {
    "BINDING_DEV_COMMANDS": true,
    "NET_CONSOLE_FORGET": true,
    "AT_RESTART_COMMAND": true,
    "AT_RESTART_FORCE": false,
    "AT_SETTING_WRITE": false,
    "AT_INTENT_COMMAND": true,
    "MEDIA_CODEC_OPUS_DECODER": true,
    "MEDIA_CODEC_OPUS_ENCODER": true,
    "SOUNDS_PACK_TONES_PCM8K": true,
    "PROVISIONING_LOCAL_POLICY": 1
  },
  "sdkconfig": [
    "CONFIG_PM_ENABLE=n",
    "CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64",
    "CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y",
    "CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y",
    "CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT=y",
    "CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y",
    "CONFIG_MBEDTLS_ECP_C=y",
    "CONFIG_MBEDTLS_ECDH_C=y",
    "CONFIG_MBEDTLS_ECDSA_C=y",
    "CONFIG_MBEDTLS_PEM_PARSE_C=y",
    "CONFIG_MBEDTLS_AES_C=y",
    "CONFIG_MBEDTLS_DES_C=n",
    "CONFIG_MBEDTLS_SHA1_C=y",
    "CONFIG_MBEDTLS_USE_CRYPTO_ROM_IMPL=n",
    "CONFIG_MBEDTLS_ROM_MD5=y",
    "CONFIG_MBEDTLS_HARDWARE_RSA_DS_PERIPHERAL=n",
    "CONFIG_ESP_TLS_USE_DS_PERIPHERAL=n",
    "CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y",
    "CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n",
    "CONFIG_MBEDTLS_DYNAMIC_BUFFER=n",
    "CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y",
    "CONFIG_ESP_TLS_INSECURE=n",
    "CONFIG_LWIP_SNTP_MAX_SERVERS=4",
    "CONFIG_LWIP_SNTP_STARTUP_DELAY=n",
    "CONFIG_MQTT_PROTOCOL_5=y",
    "CONFIG_MQTT_TRANSPORT_SSL=y",
    "CONFIG_MQTT_TRANSPORT_WEBSOCKET=n",
    "CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n"
  ]
}
