function(xiaotai_tirtc_verify_mini_contract contract_file package_name diag_header out)
    file(READ "${contract_file}" contract)
    string(JSON contract_type TYPE "${contract}")
    if(NOT contract_type STREQUAL "OBJECT")
        message(FATAL_ERROR "TiRTC contract is not an object: ${contract_file}")
    endif()
    string(JSON mini_type ERROR_VARIABLE missing TYPE "${contract}" xmini_contract)
    if(missing)
        if(package_name STREQUAL "xmini-mini")
            message(FATAL_ERROR "TiRTC Mini package has no xmini_contract")
        endif()
        set(${out} FALSE PARENT_SCOPE)
        return()
    endif()
    if(NOT mini_type STREQUAL "OBJECT")
        message(FATAL_ERROR "TiRTC Mini xmini_contract is not an object")
    endif()
    foreach(field pending_close_contract pending_command_requested_byte_budget diagnostic_version)
        string(JSON type TYPE "${contract}" xmini_contract ${field})
        string(JSON ${field} GET "${contract}" xmini_contract ${field})
        if(NOT type STREQUAL "NUMBER" OR NOT ${field} MATCHES "^[0-9]+$")
            message(FATAL_ERROR "Invalid TiRTC Mini contract field: ${field}")
        endif()
    endforeach()
    if(NOT pending_close_contract STREQUAL "1" OR NOT pending_command_requested_byte_budget STREQUAL "16384"
       OR NOT diagnostic_version STREQUAL "2")
        message(FATAL_ERROR "TiRTC Mini package pending-close/command/diagnostic contract mismatch")
    endif()
    string(JSON hash_type TYPE "${contract}" xmini_contract diagnostic_header_sha256)
    string(JSON expected GET "${contract}" xmini_contract diagnostic_header_sha256)
    string(LENGTH "${expected}" hash_length)
    if(NOT hash_type STREQUAL "STRING" OR NOT hash_length EQUAL 64 OR NOT expected MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid TiRTC Mini diagnostic header SHA-256 in contract")
    endif()
    file(SHA256 "${diag_header}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "TiRTC Mini private diagnostic header SHA-256 mismatch")
    endif()
    set(${out} TRUE PARENT_SCOPE)
endfunction()
