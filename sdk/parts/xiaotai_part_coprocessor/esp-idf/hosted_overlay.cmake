# A build-only overlay: the registry-managed Espressif tree stays pristine.
function(xiaotai_coprocessor_replace_path target property original replacement)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Coprocessor overlay: missing Hosted target ${target}")
    endif()
    get_target_property(base "${target}" SOURCE_DIR)
    get_target_property(paths "${target}" "${property}")
    set(result)
    set(matches 0)
    foreach(path IN LISTS paths)
        get_filename_component(absolute "${path}" ABSOLUTE BASE_DIR "${base}")
        if(absolute STREQUAL original)
            list(APPEND result "${replacement}")
            math(EXPR matches "${matches} + 1")
        else()
            list(APPEND result "${path}")
        endif()
    endforeach()
    if(NOT matches EQUAL 1)
        message(FATAL_ERROR "Coprocessor overlay: Hosted ${target} ${property} must register ${original} once")
    endif()
    set_property(TARGET "${target}" PROPERTY "${property}" "${result}")
endfunction()

function(xiaotai_coprocessor_hosted_overlay sdio)
    idf_component_get_property(hosted espressif__esp_hosted COMPONENT_DIR)
    idf_component_get_property(component espressif__esp_hosted COMPONENT_LIB)
    file(STRINGS "${hosted}/idf_component.yml" version REGEX "^version:[ ]*3[.]0[.]7[ ]*$")
    if(NOT version)
        message(FATAL_ERROR "Coprocessor overlay: Hosted 3.0.7 is required")
    endif()

    set(patch_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/patches")
    set(patches "${patch_dir}/esp-hosted-3.0.7-app-desc.patch")
    set(sources
        host/features/eh_host_feat_system/src/eh_host_sys.c
        host/features/eh_host_feat_system/src/eh_host_feat_system_v2_req.c
        host/features/eh_host_feat_system/src/eh_host_feat_system_v2_resp_evt.c
        host/features/eh_host_feat_rpc/src/eh_host_feat_rpc_rx.c)
    if(sdio)
        list(APPEND patches "${patch_dir}/esp-hosted-3.0.7-p4-sdio-rx-bounce.patch")
        list(APPEND sources host/mcu/eh_host_mcu_transport/src/eh_host_bus_sdio.c)
    endif()

    # Keep siblings together because quoted includes look there first.
    set(header_owners eh_host_feat_system eh_host_feat_rpc_ext_v2)
    set(files ${sources})
    foreach(owner IN LISTS header_owners)
        set(dir "host/features/${owner}/include")
        file(GLOB headers LIST_DIRECTORIES FALSE RELATIVE "${hosted}" "${hosted}/${dir}/*")
        if(NOT headers)
            message(FATAL_ERROR "Coprocessor overlay: missing Hosted headers in ${dir}")
        endif()
        list(APPEND files ${headers})
    endforeach()

    set(root "${CMAKE_BINARY_DIR}/xiaotai-coprocessor")
    set(stage "${root}/stage")
    set(output "${root}/overlay")
    foreach(file IN LISTS files)
        configure_file("${hosted}/${file}" "${stage}/${file}" COPYONLY)
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${patches} "${hosted}/idf_component.yml")
    find_package(Git REQUIRED)
    set(apply "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
        "GIT_CEILING_DIRECTORIES=${root}" "${GIT_EXECUTABLE}" -c core.autocrlf=false apply --ignore-space-change)
    execute_process(COMMAND ${apply} --check ${patches} WORKING_DIRECTORY "${stage}"
        RESULT_VARIABLE verified ERROR_VARIABLE detail)
    if(NOT verified EQUAL 0)
        message(FATAL_ERROR "Coprocessor overlay: patch does not match locked source: ${detail}")
    endif()
    execute_process(COMMAND ${apply} ${patches} WORKING_DIRECTORY "${stage}" COMMAND_ERROR_IS_FATAL ANY)
    foreach(file IN LISTS files)
        configure_file("${stage}/${file}" "${output}/${file}" COPYONLY)
    endforeach()

    foreach(owner IN LISTS header_owners)
        set(dir "host/features/${owner}/include")
        foreach(property IN ITEMS INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
            xiaotai_coprocessor_replace_path("${owner}" "${property}" "${hosted}/${dir}" "${output}/${dir}")
        endforeach()
        xiaotai_coprocessor_replace_path("${component}" INTERFACE_INCLUDE_DIRECTORIES "${hosted}/${dir}" "${output}/${dir}")
    endforeach()
    foreach(file IN LISTS sources)
        get_filename_component(src "${file}" DIRECTORY)
        get_filename_component(owner "${src}" DIRECTORY)
        get_filename_component(target "${owner}" NAME)
        xiaotai_coprocessor_replace_path("${target}" SOURCES "${hosted}/${file}" "${output}/${file}")
    endforeach()
endfunction()
