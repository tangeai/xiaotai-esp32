# Generates a candidate source only. No target or legacy product is changed.
set(_xiaotai_raw_try_take_extension "${CMAKE_CURRENT_LIST_DIR}/raw_try_take.inc")

function(xiaotai_dvp_generate_raw_try_take camera_dir out_var)
    get_filename_component(camera_dir "${camera_dir}" REALPATH)
    set(original "${camera_dir}/driver/cam_hal.c")
    if(NOT EXISTS "${camera_dir}/.component_hash" OR NOT EXISTS "${original}")
        message(FATAL_ERROR "The pristine esp32-camera 2.1.7 sources are required")
    endif()
    file(READ "${camera_dir}/.component_hash" component_hash)
    string(STRIP "${component_hash}" component_hash)
    file(READ "${original}" original_text)
    string(REPLACE "\r\n" "\n" original_text "${original_text}")
    string(SHA256 original_hash "${original_text}")
    if(NOT component_hash STREQUAL "bc9c8a6b51df777a014fa295825b3de5069bc0300c317acff20c97cf4a10ac7d"
       OR NOT original_hash STREQUAL "d74ee1f64f28dc61bf64e0a43cf0074011686e5b91c1bc9cd8549e143cd63f80")
        message(FATAL_ERROR "Unreviewed esp32-camera source; refusing the raw try-take overlay")
    endif()

    get_filename_component(build_dir "${CMAKE_BINARY_DIR}" REALPATH)
    set(generated_dir "${build_dir}/xiaotai_camera_dvp_overlay")
    set(generated "${generated_dir}/cam_hal.c")
    file(RELATIVE_PATH from_vendor "${camera_dir}" "${generated}")
    if((NOT IS_ABSOLUTE "${from_vendor}" AND NOT from_vendor MATCHES "^\\.\\.(/|$)")
       OR IS_SYMLINK "${generated_dir}" OR IS_SYMLINK "${generated}")
        message(FATAL_ERROR "Camera overlay output must be in a separate build directory")
    endif()
    file(READ "${_xiaotai_raw_try_take_extension}" extension)
    string(REPLACE "\r\n" "\n" extension "${extension}")
    set(camera_anchor "static cam_obj_t *cam_obj = NULL;\n")
    set(reset_anchor "    size_t frame_buffer_queue_len = cam_obj->frame_cnt;")
    set(stamp_anchor "                        //send frame\n")
    foreach(anchor camera_anchor reset_anchor stamp_anchor)
        string(FIND "${original_text}" "${${anchor}}" position)
        if(position LESS 0)
            message(FATAL_ERROR "Missing reviewed DVP overlay anchor: ${anchor}")
        endif()
    endforeach()
    string(REPLACE "${camera_anchor}" "${camera_anchor}\n${extension}\n" patched "${original_text}")
    string(REPLACE "${reset_anchor}" "    xt_dvp_reset_sequence();\n${reset_anchor}" patched "${patched}")
    string(REPLACE "${stamp_anchor}"
        "${stamp_anchor}                        if (!cam_obj->frames[frame_pos].en) xt_dvp_stamp_raw(frame_pos);\n"
        patched "${patched}")
    set(previous "")
    if(EXISTS "${generated}")
        file(READ "${generated}" previous)
    endif()
    if(NOT patched STREQUAL previous)
        file(MAKE_DIRECTORY "${generated_dir}")
        file(WRITE "${generated}" "${patched}")
    endif()
    set(${out_var} "${generated}" PARENT_SCOPE)
endfunction()
