function(xiaotai_dvp_generate_sccb_release camera_dir out_var)
    get_filename_component(camera_dir "${camera_dir}" REALPATH)
    set(original "${camera_dir}/driver/sccb-ng.c")
    if(NOT EXISTS "${camera_dir}/.component_hash" OR NOT EXISTS "${original}")
        message(FATAL_ERROR "The pristine esp32-camera 2.1.7 SCCB sources are required")
    endif()
    file(READ "${camera_dir}/.component_hash" component_hash)
    string(STRIP "${component_hash}" component_hash)
    file(READ "${original}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(SHA256 hash "${text}")
    if(NOT component_hash STREQUAL "bc9c8a6b51df777a014fa295825b3de5069bc0300c317acff20c97cf4a10ac7d"
       OR NOT hash STREQUAL "d43a34203460c38fb200feb98d151ecbc0346305dd5642cd59e822a5e0d955b7")
        message(FATAL_ERROR "Unreviewed esp32-camera SCCB source; refusing the borrowed-device overlay")
    endif()

    get_filename_component(build_dir "${CMAKE_BINARY_DIR}" REALPATH)
    set(directory "${build_dir}/xiaotai_camera_dvp_overlay")
    set(generated "${directory}/sccb-ng.c")
    file(RELATIVE_PATH from_vendor "${camera_dir}" "${generated}")
    if((NOT IS_ABSOLUTE "${from_vendor}" AND NOT from_vendor MATCHES "^\\.\\.(/|$)")
       OR IS_SYMLINK "${directory}" OR IS_SYMLINK "${generated}")
        message(FATAL_ERROR "SCCB overlay output must be in a separate build directory")
    endif()
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/sccb_release.inc" extension)
    string(REPLACE "\r\n" "\n" extension "${extension}")
    set(patched "${text}\n${extension}")
    set(previous "")
    if(EXISTS "${generated}")
        file(READ "${generated}" previous)
    endif()
    if(NOT patched STREQUAL previous)
        file(MAKE_DIRECTORY "${directory}")
        file(WRITE "${generated}" "${patched}")
    endif()
    set(${out_var} "${generated}" PARENT_SCOPE)
endfunction()

function(xiaotai_dvp_generate_public_wrapper camera_dir out_var)
    get_filename_component(camera_dir "${camera_dir}" REALPATH)
    file(READ "${camera_dir}/driver/esp_camera.c" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(SHA256 wrapper_hash "${text}")
    if(NOT wrapper_hash STREQUAL "0bc8fb0cc5e313f394df19fe3f7827bc2d4a209b6e8e9ee5b8fea4aa1b5e5e8d")
        message(FATAL_ERROR "Unreviewed esp32-camera public wrapper; recheck camera init and cleanup ownership")
    endif()
    foreach(action set_pixformat init_status)
        if(action STREQUAL "set_pixformat")
            set(arguments "&s_state->sensor, pix_format")
        else()
            set(arguments "&s_state->sensor")
        endif()
        set(anchor "    s_state->sensor.${action}(${arguments});\n")
        string(FIND "${text}" "${anchor}" position)
        if(position LESS 0)
            message(FATAL_ERROR "Missing reviewed sensor callback: ${action}")
        endif()
        string(REPLACE "${anchor}"
            "    if (s_state->sensor.${action}(${arguments}) != 0) {\n        ESP_LOGE(TAG, \"Camera sensor callback failed: ${action}\");\n        err = ESP_FAIL;\n        goto fail;\n    }\n"
            text "${text}")
    endforeach()
    get_filename_component(build_dir "${CMAKE_BINARY_DIR}" REALPATH)
    set(directory "${build_dir}/xiaotai_camera_dvp_overlay")
    set(generated "${directory}/esp_camera.c")
    file(RELATIVE_PATH from_vendor "${camera_dir}" "${generated}")
    if((NOT IS_ABSOLUTE "${from_vendor}" AND NOT from_vendor MATCHES "^\\.\\.(/|$)")
       OR IS_SYMLINK "${directory}" OR IS_SYMLINK "${generated}")
        message(FATAL_ERROR "Camera wrapper output must be in a separate build directory")
    endif()
    set(previous "")
    if(EXISTS "${generated}")
        file(READ "${generated}" previous)
    endif()
    if(NOT text STREQUAL previous)
        file(MAKE_DIRECTORY "${directory}")
        file(WRITE "${generated}" "${text}")
    endif()
    set(${out_var} "${generated}" PARENT_SCOPE)
endfunction()

function(xiaotai_dvp_replace_native_sources component camera_dir cam_hal sccb wrapper)
    get_target_property(base "${component}" SOURCE_DIR)
    get_target_property(sources "${component}" SOURCES)
    set(hal_matches 0)
    set(sccb_matches 0)
    set(wrapper_matches 0)
    set(updated)
    foreach(source IN LISTS sources)
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${base}")
        if(absolute STREQUAL "${camera_dir}/driver/cam_hal.c")
            list(APPEND updated "${cam_hal}")
            math(EXPR hal_matches "${hal_matches}+1")
        elseif(absolute STREQUAL "${camera_dir}/driver/sccb-ng.c")
            list(APPEND updated "${sccb}")
            math(EXPR sccb_matches "${sccb_matches}+1")
        elseif(absolute STREQUAL "${camera_dir}/driver/esp_camera.c")
            list(APPEND updated "${wrapper}")
            math(EXPR wrapper_matches "${wrapper_matches}+1")
        else()
            list(APPEND updated "${source}")
        endif()
    endforeach()
    if(NOT hal_matches EQUAL 1 OR NOT sccb_matches EQUAL 1 OR NOT wrapper_matches EQUAL 1)
        message(FATAL_ERROR "DVP requires exactly one reviewed camera HAL and new-I2C SCCB source")
    endif()
    set_property(TARGET "${component}" PROPERTY SOURCES "${updated}")
endfunction()

# Call only from the new product graph, after ESP-IDF created the targets.
function(xiaotai_dvp_enable_native_overlay)
    idf_component_get_property(camera_dir espressif__esp32-camera COMPONENT_DIR)
    idf_component_get_property(component espressif__esp32-camera COMPONENT_LIB)
    xiaotai_dvp_generate_public_wrapper("${camera_dir}" wrapper)
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/raw_try_take_overlay.cmake")
    xiaotai_dvp_generate_raw_try_take("${camera_dir}" cam_hal)
    xiaotai_dvp_generate_sccb_release("${camera_dir}" sccb)
    xiaotai_dvp_replace_native_sources("${component}" "${camera_dir}" "${cam_hal}" "${sccb}" "${wrapper}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${camera_dir}/.component_hash" "${camera_dir}/driver/cam_hal.c" "${camera_dir}/driver/sccb-ng.c"
        "${camera_dir}/driver/esp_camera.c"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/raw_try_take.inc" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/sccb_release.inc")
endfunction()
