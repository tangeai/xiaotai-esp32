set(_xiaotai_monitor_dir "${CMAKE_CURRENT_LIST_DIR}")
# Both reviewed sources share the same monitor logic; 6.0 adds the explicit FreeRTOS include.
set(XIAOTAI_USB_MONITOR_SHA256_5.5 "58779a75668f9d253a7f0ea0c8a7bbb194204a41b8979b98b7261c1954c5d29d")
set(XIAOTAI_USB_MONITOR_SHA256_6.0 "ac8fd6de48f3bc660b880f07de8701f1a468b1183b929247be2eedfe4aa04c47")

function(xiaotai_port_configure_usb_monitor)
    if(NOT CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG OR NOT CONFIG_XIAOTAI_PORT_USB_MONITOR_FIX)
        return()
    endif()
    idf_component_get_property(usb_dir esp_driver_usb_serial_jtag COMPONENT_DIR)
    idf_component_get_property(usb_lib esp_driver_usb_serial_jtag COMPONENT_LIB)
    set(original "${usb_dir}/src/usb_serial_jtag_connection_monitor.c")
    file(READ "${original}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 actual "${content}")
    set(line "${IDF_VERSION_MAJOR}.${IDF_VERSION_MINOR}")
    if(NOT DEFINED XIAOTAI_USB_MONITOR_SHA256_${line}
       OR NOT actual STREQUAL "${XIAOTAI_USB_MONITOR_SHA256_${line}}")
        message(FATAL_ERROR "USB monitor for ESP-IDF ${line} is not the reviewed source; "
                            "compare SOF ownership and timing before adapting")
    endif()
    set(replacement "${_xiaotai_monitor_dir}/usb_connection_monitor.c")
    set(count 0)
    set(updated "")
    get_target_property(sources "${usb_lib}" SOURCES)
    foreach(source IN LISTS sources)
        if(source STREQUAL original)
            math(EXPR count "${count} + 1")
            list(APPEND updated "${replacement}")
        else()
            list(APPEND updated "${source}")
        endif()
    endforeach()
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "IDF USB monitor source registration changed; refusing to replace it")
    endif()
    set_property(TARGET "${usb_lib}" PROPERTY SOURCES "${updated}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${replacement}")
endfunction()
