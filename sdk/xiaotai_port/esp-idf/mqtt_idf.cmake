function(xiaotai_mqtt_replace_target target native_dir generated expected)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Missing native MQTT target: ${target}")
    endif()
    get_target_property(aliased "${target}" ALIASED_TARGET)
    if(aliased)
        set(target "${aliased}")
    endif()
    get_target_property(base "${target}" SOURCE_DIR)
    get_target_property(sources "${target}" SOURCES)
    set(actual)
    set(updated)
    foreach(source IN LISTS sources)
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${base}")
        file(RELATIVE_PATH relative "${native_dir}" "${absolute}")
        if(NOT relative IN_LIST expected)
            message(FATAL_ERROR "Unreviewed MQTT source registration: ${target}: ${source}")
        endif()
        list(APPEND actual "${relative}")
        list(APPEND updated "${generated}/${relative}")
    endforeach()
    list(SORT actual)
    list(SORT expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "MQTT target source set changed: ${target}: ${actual}")
    endif()
    set_property(TARGET "${target}" PROPERTY SOURCES "${updated}")
    foreach(property IN ITEMS INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
        get_target_property(includes "${target}" "${property}")
        if(NOT includes)
            continue()
        endif()
        set(updated)
        foreach(path IN LISTS includes)
            if(NOT path MATCHES "^\\$<")
                get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${base}")
            endif()
            string(REPLACE "${native_dir}/" "${generated}/" path "${path}")
            list(APPEND updated "${path}")
        endforeach()
        set_property(TARGET "${target}" PROPERTY "${property}" "${updated}")
    endforeach()
    target_include_directories("${target}" BEFORE PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
endfunction()

# Only the new product graph calls this, after IDF created all native targets.
function(xiaotai_port_configure_mqtt)
    idf_component_get_property(native_dir espressif__mqtt COMPONENT_DIR)
    idf_component_get_property(native_target espressif__mqtt COMPONENT_LIB)
    get_filename_component(native_dir "${native_dir}" REALPATH)
    idf_build_get_property(python PYTHON)
    if(NOT python)
        find_package(Python3 REQUIRED COMPONENTS Interpreter)
        set(python "${Python3_EXECUTABLE}")
    endif()
    execute_process(
        COMMAND "${python}" -B "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/mqtt_native_overlay.py"
                "${native_dir}" --build-root "${CMAKE_BINARY_DIR}/xiaotai-native-mqtt"
        RESULT_VARIABLE status OUTPUT_VARIABLE generated ERROR_VARIABLE detail
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot prepare the locked native MQTT adapter: ${detail}")
    endif()
    file(TO_CMAKE_PATH "${generated}" generated)
    set(client_sources mqtt_client.c lib/mqtt_msg.c lib/platform_esp32_idf.c)
    if(CONFIG_MQTT_PROTOCOL_5)
        list(APPEND client_sources mqtt5_client.c lib/mqtt5_msg.c)
    endif()
    xiaotai_mqtt_replace_target("${native_target}" "${native_dir}" "${generated}" "${client_sources}")
    xiaotai_mqtt_replace_target(idf::mqtt::outbox "${native_dir}" "${generated}" "lib/mqtt_outbox.c")
    xiaotai_mqtt_replace_target(idf::mqtt::utils "${native_dir}" "${generated}" "lib/mqtt_utils/mqtt_utils.c")
    file(GLOB port_inputs LIST_DIRECTORIES FALSE
         "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/mqtt*.py" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/mqtt*.inc"
         "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/mqtt*.h" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/mqtt.c"
         "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/mqtt_idf.cmake")
    file(GLOB_RECURSE native_inputs LIST_DIRECTORIES FALSE "${native_dir}/*.c" "${native_dir}/*.h")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                 ${port_inputs} ${native_inputs} "${native_dir}/LICENSE")
endfunction()
