# Preserve the original WT bus counters without editing the shared Hosted cache.
function(xiaotai_generate_hosted_spi source output)
    file(READ "${source}" original)
    string(REPLACE "\r\n" "\n" original "${original}")
    string(SHA256 source_hash "${original}")
    if(NOT source_hash STREQUAL "772e8ec27103683c1f077583976c50a3a59d3bf12e7df8ce1b865804dbb54692")
        message(FATAL_ERROR "Hosted SPI source changed; review the WT diagnostics adapter")
    endif()
    set(patch "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/patches/esp-hosted-3.0.7-spi-diagnostics.patch")
    get_filename_component(output_dir "${output}" DIRECTORY)
    set(stage "${output_dir}/spi-diagnostics-stage")
    file(MAKE_DIRECTORY "${stage}")
    file(WRITE "${stage}/eh_host_bus_spi.c" "${original}")
    find_package(Git REQUIRED)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE
            --unset=GIT_INDEX_FILE "GIT_CEILING_DIRECTORIES=${output_dir}"
            "${GIT_EXECUTABLE}" apply "${patch}"
        WORKING_DIRECTORY "${stage}"
        RESULT_VARIABLE applied ERROR_VARIABLE detail)
    if(NOT applied EQUAL 0)
        message(FATAL_ERROR "WT SPI diagnostics patch failed: ${detail}")
    endif()
    file(SHA256 "${stage}/eh_host_bus_spi.c" output_hash)
    if(NOT output_hash STREQUAL "7b9e787418fbce6c8485069087573ddda11befdd48b7ca121d64e84bd8b1f4f4")
        message(FATAL_ERROR "WT SPI diagnostics output differs from the reviewed source")
    endif()
    configure_file("${stage}/eh_host_bus_spi.c" "${output}" COPYONLY)
    file(REMOVE "${stage}/eh_host_bus_spi.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}" "${patch}")
endfunction()

function(xiaotai_enable_hosted_spi_diagnostics)
    idf_component_get_property(hosted_dir espressif__esp_hosted COMPONENT_DIR)
    set(hosted_lib eh_host_mcu_transport)
    if(NOT TARGET ${hosted_lib})
        message(FATAL_ERROR "Hosted MCU transport target is missing")
    endif()
    set(original "${hosted_dir}/host/mcu/eh_host_mcu_transport/src/eh_host_bus_spi.c")
    set(generated "${CMAKE_BINARY_DIR}/xiaotai_hosted/eh_host_bus_spi.c")
    get_target_property(sources ${hosted_lib} SOURCES)
    get_target_property(source_dir ${hosted_lib} SOURCE_DIR)
    set(replaced 0)
    set(selected "")
    foreach(source IN LISTS sources)
        get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${source_dir}")
        if(absolute STREQUAL original)
            list(APPEND selected "${generated}")
            math(EXPR replaced "${replaced} + 1")
        else()
            list(APPEND selected "${source}")
        endif()
    endforeach()
    if(NOT replaced EQUAL 1)
        message(FATAL_ERROR "Hosted SPI source registration changed")
    endif()
    xiaotai_generate_hosted_spi("${original}" "${generated}")
    set_property(TARGET ${hosted_lib} PROPERTY SOURCES "${selected}")
endfunction()
