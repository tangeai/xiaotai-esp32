include_guard(GLOBAL)

if(NOT PROJECT_NAME STREQUAL "xiaotai_xmini_c3_v3" OR
   NOT IDF_TARGET STREQUAL "esp32c3" OR NOT CONFIG_IDF_TARGET_ESP32C3 OR
   NOT "${IDF_VERSION_MAJOR}.${IDF_VERSION_MINOR}.${IDF_VERSION_PATCH}" STREQUAL "5.5.5")
    message(FATAL_ERROR "The MPI workspace patch requires Xmini-C3-V3 / ESP-IDF 5.5.5")
endif()
if(NOT CONFIG_MBEDTLS_HARDWARE_MPI OR NOT CONFIG_MBEDTLS_LARGE_KEY_SOFTWARE_MPI OR
   NOT CONFIG_MBEDTLS_MPI_USE_INTERRUPT OR NOT "${CONFIG_MBEDTLS_MPI_INTERRUPT_LEVEL}" STREQUAL "0")
    message(FATAL_ERROR "Keep the validated MPI hardware, large-key fallback and interrupt profile")
endif()

function(xmini_mpi_require_sha path expected)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "MPI source missing: ${path}")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "MPI source SHA mismatch: ${path}")
    endif()
endfunction()

if(NOT TARGET mbedcrypto)
    message(FATAL_ERROR "The original mbedcrypto target is missing")
endif()
get_filename_component(xmini_crypto_expected "${IDF_PATH}/components/mbedtls/mbedtls/library" REALPATH)
get_target_property(xmini_crypto_directory mbedcrypto SOURCE_DIR)
get_filename_component(xmini_crypto_directory "${xmini_crypto_directory}" REALPATH)
if(NOT xmini_crypto_directory STREQUAL xmini_crypto_expected)
    message(FATAL_ERROR "Unexpected mbedcrypto source owner")
endif()
get_filename_component(xmini_mpi_original "${xmini_crypto_expected}/bignum.c" REALPATH)
get_filename_component(xmini_mpi_candidate "${CMAKE_CURRENT_LIST_DIR}/../vendor/mbedtls-idf-5.5.5/bignum.c" REALPATH)
xmini_mpi_require_sha("${xmini_mpi_original}" "5decc03dc8fa4f9e476fa37e67c4186c63148ed70d72506282539a3966f86abf")
xmini_mpi_require_sha("${xmini_mpi_candidate}" "45626c933a826d06b6a3782ccc252d6b10acd097c1be5fa3e27cd568dc4b49e4")

get_target_property(xmini_crypto_sources mbedcrypto SOURCES)
set(xmini_mpi_matches 0)
set(xmini_crypto_replaced)
foreach(source IN LISTS xmini_crypto_sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "bignum.c")
        math(EXPR xmini_mpi_matches "${xmini_mpi_matches}+1")
        get_filename_component(resolved "${source}" REALPATH BASE_DIR "${xmini_crypto_directory}")
        if(NOT resolved STREQUAL xmini_mpi_original)
            message(FATAL_ERROR "The bignum source is already replaced or foreign")
        endif()
        list(APPEND xmini_crypto_replaced "${xmini_mpi_candidate}")
    else()
        list(APPEND xmini_crypto_replaced "${source}")
    endif()
endforeach()
if(NOT xmini_mpi_matches EQUAL 1)
    message(FATAL_ERROR "Expected exactly one original bignum source")
endif()
set_property(TARGET mbedcrypto PROPERTY SOURCES "${xmini_crypto_replaced}")
set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${xmini_mpi_original}" "${xmini_mpi_candidate}")
