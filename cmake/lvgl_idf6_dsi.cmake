# IDF 6 reports the completed refresh through on_refresh_done. Keep the port's
# VSYNC semaphore path; the color-copy callback does not retire a scanout buffer.
idf_component_get_property(port_dir espressif__esp_lvgl_port COMPONENT_DIR)
set(original "${port_dir}/src/lvgl9/esp_lvgl_port_disp.c")
file(READ "${original}" source)
string(REPLACE "\r\n" "\n" source "${source}")
string(SHA256 source_hash "${source}")
if(NOT source_hash STREQUAL "4a1bcfd9088b6216ff33509dfc15c86886426d545012568e2f21f77239c3b0f0")
    message(FATAL_ERROR "esp_lvgl_port 2.9 display source changed; review the IDF 6 DSI callback contract")
endif()
set(before "#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 5, 0)\n            cbs.on_frame_buf_complete = lvgl_port_flush_dpi_vsync_ready_callback;")
set(after "#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 5, 0) && ESP_IDF_VERSION < ESP_IDF_VERSION_VAL(6, 0, 0)\n            cbs.on_frame_buf_complete = lvgl_port_flush_dpi_vsync_ready_callback;")
string(FIND "${source}" "${before}" anchor)
if(anchor EQUAL -1)
    message(FATAL_ERROR "DSI callback selection anchor missing")
endif()
string(REPLACE "${before}" "${after}" source "${source}")
include("${CMAKE_CURRENT_LIST_DIR}/lvgl_port_rollback.cmake")
set(generated "${CMAKE_BINARY_DIR}/xiaotai_lvgl_port/esp_lvgl_port_disp.c")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/xiaotai_lvgl_port")
file(WRITE "${generated}.tmp" "${source}")
configure_file("${generated}.tmp" "${generated}" COPYONLY)
file(REMOVE "${generated}.tmp")
if(NOT TARGET lvgl_port_lib)
    message(FATAL_ERROR "esp_lvgl_port target registration changed")
endif()
get_target_property(sources lvgl_port_lib SOURCES)
get_target_property(source_dir lvgl_port_lib SOURCE_DIR)
set(replaced 0)
set(selected "")
foreach(path IN LISTS sources)
    get_filename_component(absolute "${path}" ABSOLUTE BASE_DIR "${source_dir}")
    if(absolute STREQUAL original)
        list(APPEND selected "${generated}")
        math(EXPR replaced "${replaced} + 1")
    else()
        list(APPEND selected "${path}")
    endif()
endforeach()
if(NOT replaced EQUAL 1)
    message(FATAL_ERROR "DSI display source registration is not unique")
endif()
set_property(TARGET lvgl_port_lib PROPERTY SOURCES "${selected}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
