get_filename_component(XIAOTAI_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_board_root "${XIAOTAI_ROOT}/main/boards")
get_filename_component(XIAOTAI_SELECTED_BOARD "${_board_root}/${XIAOTAI_BOARD_DIR}" REALPATH)
string(FIND "${XIAOTAI_SELECTED_BOARD}/" "${_board_root}/" _within_board)
if(NOT _within_board EQUAL 0 OR NOT EXISTS "${XIAOTAI_SELECTED_BOARD}/board.cmake")
    message(FATAL_ERROR "Unknown or incomplete board: ${XIAOTAI_BOARD_DIR}")
endif()
set(EXTRA_COMPONENT_DIRS "")
if(EXISTS "${XIAOTAI_SELECTED_BOARD}/source-profile.json")
    file(READ "${XIAOTAI_SELECTED_BOARD}/source-profile.json" _profile)
    string(JSON XIAOTAI_PROFILE_ID GET "${_profile}" id)
    string(JSON _target GET "${_profile}" target)
    if(NOT IDF_TARGET STREQUAL _target)
        message(FATAL_ERROR "Board ${XIAOTAI_PROFILE_ID} requires ${_target}, not ${IDF_TARGET}")
    endif()
    string(JSON _application GET "${_profile}" application)
    list(APPEND EXTRA_COMPONENT_DIRS "${XIAOTAI_ROOT}/${_application}")
    string(JSON _count LENGTH "${_profile}" components)
    math(EXPR _last "${_count} - 1")
    foreach(_i RANGE ${_last})
        string(JSON _name MEMBER "${_profile}" components ${_i})
        string(JSON _path GET "${_profile}" components ${_name})
        get_filename_component(_component "${XIAOTAI_ROOT}/${_path}" REALPATH)
        string(FIND "${_component}/" "${XIAOTAI_ROOT}/" _within_root)
        if(NOT _within_root EQUAL 0 OR NOT EXISTS "${_component}/CMakeLists.txt")
            message(FATAL_ERROR "Invalid selected component: ${_path}")
        endif()
        list(APPEND EXTRA_COMPONENT_DIRS "${_component}")
    endforeach()
    set(XIAOTAI_NATIVE_PROFILE ON)
else()
    set(XIAOTAI_PROFILE_ID szpi)
    list(APPEND EXTRA_COMPONENT_DIRS "${XIAOTAI_ROOT}/profiles/szpi/xiaotai_dependencies")
    set(XIAOTAI_NATIVE_PROFILE OFF)
endif()
