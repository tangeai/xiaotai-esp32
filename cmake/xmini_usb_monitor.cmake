# Preserve Xmini's SOF evidence and elapsed-time correction in the driver owner.
# Other USB sources, VFS and public headers remain from the pinned IDF 6 tree.
idf_component_get_property(usb_dir esp_driver_usb_serial_jtag COMPONENT_DIR)
idf_component_get_property(usb_lib esp_driver_usb_serial_jtag COMPONENT_LIB)
set(original "${usb_dir}/src/usb_serial_jtag_connection_monitor.c")
file(SHA256 "${original}" source_hash)
if(NOT source_hash STREQUAL "ac8fd6de48f3bc660b880f07de8701f1a468b1183b929247be2eedfe4aa04c47")
    message(FATAL_ERROR "USB monitor changed; compare SOF ownership/time behavior before adapting")
endif()
set(replacement "${XIAOTAI_SELECTED_BOARD}/drivers/xmini_board/usb_connection_monitor.c")
get_target_property(sources ${usb_lib} SOURCES)
list(FIND sources "${original}" monitor_index)
if(monitor_index EQUAL -1)
    message(FATAL_ERROR "IDF USB monitor source registration changed")
endif()
list(REMOVE_ITEM sources "${original}")
list(APPEND sources "${replacement}")
set_property(TARGET ${usb_lib} PROPERTY SOURCES "${sources}")
target_include_directories(${usb_lib} PRIVATE "${XIAOTAI_SELECTED_BOARD}/drivers/xmini_board/include")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${replacement}")
