@@ -7,6 +7,15 @@
 
 #if EH_HOST_FEAT_SYSTEM_READY
 
+static void copy_desc_text(char *dst, size_t capacity,
+                           const ProtobufCBinaryData *src)
+{
+    if (capacity == 0 || !src || !src->data) return;
+    size_t n = src->len < capacity - 1 ? src->len : capacity - 1;
+    memcpy(dst, src->data, n);
+    dst[n] = '\0';
+}
+
 int rpc_ext_v2_parse_resp_system(const Rpc *rpc, eh_rpc_ctrl_cmd_t *c)
 {
     switch (rpc->msg_id) {
@@ -55,6 +64,27 @@ int rpc_ext_v2_parse_resp_system(const Rpc *rpc, eh_rpc_ctrl_cmd_t *c)
         return 0;
     }
 
+    case RPC_ID__Resp_AppGetDesc: {
+        RpcRespAppGetDesc *r = rpc->resp_app_get_desc;
+        if (!r) return -1;
+        c->resp_event_status = r->resp;
+        if (r->resp != 0 || !r->app_desc) return 0;
+        EspAppDesc *desc = r->app_desc;
+        eh_rpc_app_desc_t *out = &c->u.app_desc;
+        out->magic_word = desc->magic_word;
+        out->secure_version = desc->secure_version;
+        copy_desc_text(out->version, sizeof(out->version), &desc->version);
+        copy_desc_text(out->project_name, sizeof(out->project_name), &desc->project_name);
+        copy_desc_text(out->time, sizeof(out->time), &desc->time);
+        copy_desc_text(out->date, sizeof(out->date), &desc->date);
+        copy_desc_text(out->idf_ver, sizeof(out->idf_ver), &desc->idf_ver);
+        if (desc->app_elf_sha256.len == sizeof(out->app_elf_sha256) &&
+            desc->app_elf_sha256.data)
+            memcpy(out->app_elf_sha256, desc->app_elf_sha256.data,
+                   sizeof(out->app_elf_sha256));
+        return 0;
+    }
+
     default:
         return -1;
     }
