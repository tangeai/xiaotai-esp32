if(NOT CONFIG_IDF_TARGET STREQUAL "esp32p4" OR CONFIG_ESP32P4_SELECTS_REV_LESS_V3 OR
   NOT CONFIG_ESP32P4_REV_MIN_FULL EQUAL 301 OR NOT CONFIG_ESP32P4_REV_MAX_FULL EQUAL 399 OR
   NOT CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ EQUAL 400 OR CONFIG_HAL_WDT_USE_ROM_IMPL)
    message(FATAL_ERROR "WT99P461-S1 requires rev3.1-3.99, 400 MHz and non-ROM WDT")
endif()
if(CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN OR CONFIG_ESP_HOSTED_HOST_TRANSPORT_RESTART_ON_FAILURE)
    message(FATAL_ERROR "WT99P461-S1 owns Hosted startup and explicit retry")
endif()
if(NOT CONFIG_SLAVE_IDF_TARGET_ESP32C61 OR NOT CONFIG_ESP_HOSTED_CP_TARGET_ESP32C61 OR
   NOT CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SPI OR CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO OR
   NOT CONFIG_ESP_HOSTED_HOST_RESET_ACTIVE_LOW)
    message(FATAL_ERROR "WT99P461-S1 requires C61 full-duplex SPI with active-low reset")
endif()
set(spi_signals MOSI MISO CLK CS)
set(spi_pins 14 15 18 19)
foreach(signal pin IN ZIP_LISTS spi_signals spi_pins)
    if(NOT CONFIG_ESP_HOSTED_HOST_SPI_${signal}_GPIO EQUAL pin)
        message(FATAL_ERROR "WT99P461-S1 SPI ${signal} must use GPIO${pin}")
    endif()
endforeach()
if(NOT CONFIG_ESP_HOSTED_HOST_HANDSHAKE_GPIO EQUAL 16 OR
   NOT CONFIG_ESP_HOSTED_HOST_DATA_READY_GPIO EQUAL 17 OR
   NOT CONFIG_ESP_HOSTED_HOST_RESET_GPIO EQUAL 13 OR
   NOT CONFIG_ESP_HOSTED_HOST_SPI_MODE EQUAL 3 OR
   NOT CONFIG_ESP_HOSTED_HOST_SPI_CLK_MHZ EQUAL 10)
    message(FATAL_ERROR "WT99P461-S1 requires HS16/DR17/RST13, SPI mode 3 at 10 MHz")
endif()
if(NOT CONFIG_CAMERA_SC2336 OR CONFIG_CAMERA_OV5647 OR
   NOT CONFIG_CAMERA_SC2336_MIPI_DEFAULT_FMT_RAW8_1024X600_30FPS OR
   NOT CONFIG_CAMERA_SC2336_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE OR
   NOT CONFIG_CAMERA_SC2336_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH STREQUAL
       "boards/wt/wt99p461-s1/assets/sc2336_isp.json")
    message(FATAL_ERROR "WT99P461-S1 requires SC2336 RAW8 1024x600 and its reviewed ISP tuning")
endif()
idf_build_get_property(python PYTHON)
execute_process(COMMAND "${python}" -B "${CMAKE_CURRENT_LIST_DIR}/check_isp.py"
                COMMAND_ERROR_IS_FATAL ANY)
