CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
# CONFIG_HAL_WDT_USE_ROM_IMPL is not set
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=196608
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y

# CONFIG_CAMERA_OV5647 is not set
CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_SC2336_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC2336_MIPI_RAW8_1024X600_30FPS=y
# CONFIG_CAMERA_SC2336_MIPI_RAW8_1280X720_30FPS is not set
CONFIG_CAMERA_SC2336_MIPI_DEFAULT_FMT_RAW8_1024X600_30FPS=y
# CONFIG_CAMERA_SC2336_DEFAULT_IPA_JSON_CONFIGURATION_FILE is not set
CONFIG_CAMERA_SC2336_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_SC2336_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="boards/wt/wt99p461-s1/assets/sc2336_isp.json"

# WT01P461 C61 module: full-duplex SPI, explicit startup/retry, never SDIO.
# CONFIG_ESP_HOST_WIFI_ENABLED is not set
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C61=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C61=y
# CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO is not set
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SPI=y
CONFIG_ESP_HOSTED_HOST_SPI_CONTROLLER_HSPI=y
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=13
CONFIG_ESP_HOSTED_HOST_RESET_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_HOST_SPI_MOSI_GPIO=14
CONFIG_ESP_HOSTED_HOST_SPI_MISO_GPIO=15
CONFIG_ESP_HOSTED_HOST_SPI_CLK_GPIO=18
CONFIG_ESP_HOSTED_HOST_SPI_CS_GPIO=19
CONFIG_ESP_HOSTED_HOST_HANDSHAKE_GPIO=16
CONFIG_ESP_HOSTED_HOST_DATA_READY_GPIO=17
CONFIG_ESP_HOSTED_HOST_SPI_CLK_MHZ=10
CONFIG_ESP_HOSTED_HOST_SPI_MODE=3
CONFIG_ESP_HOSTED_HOST_SPI_TX_Q_SIZE=20
CONFIG_ESP_HOSTED_HOST_SPI_RX_Q_SIZE=20
CONFIG_ESP_HOSTED_HOST_FEAT_PEER_DATA=y
CONFIG_ESP_HOSTED_HOST_CP_BRINGUP_ON_TIMEOUT_NONE=y
# CONFIG_ESP_HOSTED_HOST_TRANSPORT_RESTART_ON_FAILURE is not set
# CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN is not set
# CONFIG_ESP_HOSTED_HOST_TO_ESP_WIFI_DATA_THROTTLE is not set
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_STATIC_TX_BUFFER=y
CONFIG_WIFI_RMT_STATIC_TX_BUFFER_NUM=16
CONFIG_WIFI_RMT_CACHE_TX_BUFFER_NUM=32
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=6
# CONFIG_WIFI_RMT_SLP_IRAM_OPT is not set
# CONFIG_WIFI_RMT_STA_DISCONNECTED_PM_ENABLE is not set
CONFIG_WIFI_RMT_IRAM_OPT=y
CONFIG_WIFI_RMT_EXTRA_IRAM_OPT=y
CONFIG_WIFI_RMT_RX_IRAM_OPT=y
