if(NOT CONFIG_IDF_TARGET STREQUAL "esp32p4" OR
   CONFIG_ESP32P4_SELECTS_REV_LESS_V3 OR
   NOT CONFIG_ESP32P4_REV_MIN_FULL EQUAL 301 OR
   NOT CONFIG_ESP32P4_REV_MAX_FULL EQUAL 399 OR
   NOT CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ EQUAL 400 OR CONFIG_HAL_WDT_USE_ROM_IMPL)
    message(FATAL_ERROR "Waveshare P4 requires rev3.1-3.99, 400 MHz and non-ROM WDT")
endif()
if(NOT CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6 OR
   NOT CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO OR
   NOT CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ MATCHES "^[1-9][0-9]*$" OR
   CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ GREATER 40000)
    message(FATAL_ERROR "Waveshare P4 requires C6 with an explicit SDR SDIO clock <= 40000 kHz")
endif()
if(NOT CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS OR
   NOT CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1280X960_BINNING_45FPS OR
   NOT CONFIG_CAMERA_OV5647_MIPI_IF_FORMAT_INDEX_DEFAULT EQUAL 4)
    message(FATAL_ERROR "Waveshare P4 CSI requires OV5647 RAW10 1280x960 at 45 fps as the default mode (index 4)")
endif()
