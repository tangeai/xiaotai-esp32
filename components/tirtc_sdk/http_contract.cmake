function(tirtc_http_capability contract symbols output)
    string(JSON backend GET "${contract}" http_tls_backend)
    if(backend STREQUAL "none")
        if(NOT symbols MATCHES "httpclt\\.o:" OR symbols MATCHES "httpclt\\.o:[^\n]* U mbedtls_ssl_")
            message(FATAL_ERROR "HTTP-only SDK archive does not match its declared capability")
        endif()
        set(${output} 0 PARENT_SCOPE)
    elseif(backend STREQUAL "mbedtls")
        foreach(symbol IN ITEMS handshake setup read write)
            if(NOT symbols MATCHES "httpclt\\.o:[^\n]* U mbedtls_ssl_${symbol}([\r\n]|$)")
                message(FATAL_ERROR "TiRTC HTTPS capability is not present in httpclt.o: ${symbol}")
            endif()
        endforeach()
        set(${output} 1 PARENT_SCOPE)
    else()
        message(FATAL_ERROR "Unreviewed TiRTC HTTP TLS backend")
    endif()
endfunction()
