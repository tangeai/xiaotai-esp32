# scripts/build.py resolves the product's TiRTC package from packages.json and
# passes "<IDF line>/<package>"; this file only maps it to paths and checks it.
# An official package ("path" in packages.json) is downloaded and unpacked by
# scripts/fetch_tirtc.py into packages/<name>/; its contract lives in contracts/.
idf_build_get_property(tirtc_package XIAOTAI_TIRTC_PACKAGE)
if(NOT tirtc_package MATCHES "^([0-9]+\\.[0-9]+)/([a-z0-9-]+)$")
    message(FATAL_ERROR "No TiRTC package selected; build with scripts/build.py")
endif()
set(tirtc_line "${CMAKE_MATCH_1}")
set(tirtc_package_name "${CMAKE_MATCH_2}")
file(READ "${CMAKE_CURRENT_LIST_DIR}/packages.json" tirtc_packages)
string(JSON tirtc_entry ERROR_VARIABLE tirtc_entry_error
    GET "${tirtc_packages}" lines "${tirtc_line}" packages "${tirtc_package_name}")
if(tirtc_entry_error)
    message(FATAL_ERROR "Unknown TiRTC package: ${tirtc_package}")
endif()
string(JSON tirtc_path ERROR_VARIABLE tirtc_in_tree GET "${tirtc_entry}" path)
if(tirtc_in_tree)
    string(JSON tirtc_lib GET "${tirtc_entry}" lib)
    string(JSON tirtc_include GET "${tirtc_entry}" include)
    set(sdk_dir "${CMAKE_CURRENT_LIST_DIR}/${tirtc_lib}")
    set(tirtc_include_dir "${CMAKE_CURRENT_LIST_DIR}/${tirtc_include}")
else()
    string(REGEX REPLACE "^.*/" "" tirtc_name "${tirtc_path}")
    set(tirtc_root "${CMAKE_CURRENT_LIST_DIR}/packages/${tirtc_name}")
    set(sdk_dir "${tirtc_root}/lib")
    set(tirtc_include_dir "${tirtc_root}/include")
    if(NOT EXISTS "${sdk_dir}/libTiRTC.a")
        message(FATAL_ERROR "TiRTC package ${tirtc_name} is not downloaded; run: python scripts/fetch_tirtc.py --line ${tirtc_line}")
    endif()
endif()
string(JSON tirtc_contract ERROR_VARIABLE tirtc_contract_default GET "${tirtc_entry}" contract)
if(tirtc_contract_default)
    set(tirtc_contract_file "${sdk_dir}/contract.json")
else()
    set(tirtc_contract_file "${CMAKE_CURRENT_LIST_DIR}/${tirtc_contract}")
endif()
