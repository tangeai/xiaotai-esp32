idf_build_get_property(tirtc_board XIAOTAI_BOARD_DIR)
set(tirtc_include_dir "${CMAKE_CURRENT_LIST_DIR}/include")
set(sdk_dir "${CMAKE_CURRENT_LIST_DIR}/lib/${IDF_TARGET}")
if(tirtc_board STREQUAL "xmini/c3-v3")
    if(NOT IDF_TARGET STREQUAL "esp32c3")
        message(FATAL_ERROR "Xmini Mini SDK is an ESP32-C3-only producer")
    endif()
    set(sdk_dir "${CMAKE_CURRENT_LIST_DIR}/variants/xmini/lib")
    set(tirtc_include_dir "${CMAKE_CURRENT_LIST_DIR}/variants/xmini/include")
elseif(tirtc_board STREQUAL "lckfb/szpi-esp32s3")
    if(NOT IDF_TARGET STREQUAL "esp32s3")
        message(FATAL_ERROR "SZPI HTTP SDK is an ESP32-S3-only producer")
    endif()
    set(sdk_dir "${CMAKE_CURRENT_LIST_DIR}/variants/szpi-http/lib")
    set(tirtc_include_dir "${CMAKE_CURRENT_LIST_DIR}/variants/szpi-http/include")
endif()
