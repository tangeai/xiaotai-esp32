# crypto_mode "full" (default): the contract lists the producer's whole Mbed TLS
# configuration and the application must match it exactly, in both directions.
# crypto_mode "required": the package publishes no producer configuration, so the
# contract lists only the settings its archive depends on; others are unconstrained.
# crypto_mode "bundled": the archive carries its own crypto under its own symbol
# prefix (the official ESP-IDF 6 packages); it constrains no Mbed TLS setting,
# and the build proves from the archive (second argument: nm -A output) that it
# calls no mbedtls_* or psa_* function of ESP-IDF.
function(tirtc_validate_crypto_contract contract)
    string(JSON crypto_mode ERROR_VARIABLE mode_missing GET "${contract}" crypto_mode)
    if(mode_missing)
        set(crypto_mode full)
    endif()
    if(crypto_mode STREQUAL "bundled")
        if(ARGC LESS 2)
            message(FATAL_ERROR "A bundled-crypto TiRTC contract needs the archive's symbols")
        endif()
        if(ARGV1 MATCHES "[ \t]U (mbedtls|psa)_[A-Za-z0-9_]+")
            message(FATAL_ERROR "TiRTC archive declared bundled crypto but calls ESP-IDF: ${CMAKE_MATCH_0}")
        endif()
        return()
    endif()
    if(NOT crypto_mode MATCHES "^(full|required)$")
        message(FATAL_ERROR "Unknown TiRTC crypto_mode: ${crypto_mode}")
    endif()
    string(JSON crypto_count LENGTH "${contract}" crypto_config)
    if(crypto_count LESS 1)
        message(FATAL_ERROR "TiRTC crypto configuration contract is empty")
    endif()
    math(EXPR crypto_last "${crypto_count}-1")
    foreach(index RANGE 0 ${crypto_last})
        string(JSON symbol MEMBER "${contract}" crypto_config ${index})
        string(JSON expected GET "${contract}" crypto_config ${symbol})
        if(NOT DEFINED ${symbol} OR NOT "${${symbol}}" STREQUAL "${expected}")
            message(FATAL_ERROR "TiRTC crypto ABI mismatch: ${symbol} requires ${expected}, got '${${symbol}}'; rebuild the SDK for this configuration")
        endif()
    endforeach()
    if(crypto_mode STREQUAL "required")
        return()
    endif()
    get_cmake_property(config_variables VARIABLES)
    foreach(symbol IN LISTS config_variables)
        if(symbol MATCHES "^CONFIG_(MBEDTLS|PSA)_" AND NOT "${${symbol}}" STREQUAL "")
            string(JSON expected ERROR_VARIABLE missing GET "${contract}" crypto_config ${symbol})
            if(NOT missing STREQUAL "NOTFOUND")
                message(FATAL_ERROR "TiRTC crypto ABI mismatch: additional application setting ${symbol}")
            endif()
        endif()
    endforeach()
endfunction()
