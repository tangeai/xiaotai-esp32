function(tirtc_validate_crypto_contract contract)
    string(JSON crypto_count LENGTH "${contract}" crypto_config)
    if(crypto_count LESS 1)
        message(FATAL_ERROR "TiRTC crypto configuration contract is empty")
    endif()
    math(EXPR crypto_last "${crypto_count}-1")
    foreach(index RANGE 0 ${crypto_last})
        string(JSON symbol MEMBER "${contract}" crypto_config ${index})
        string(JSON expected GET "${contract}" crypto_config ${symbol})
        if(NOT DEFINED ${symbol} OR NOT "${${symbol}}" STREQUAL "${expected}")
            message(FATAL_ERROR "TiRTC crypto ABI mismatch: ${symbol} requires ${expected}, got '${${symbol}}'; rebuild the SDK for this configuration")
        endif()
    endforeach()
    get_cmake_property(config_variables VARIABLES)
    foreach(symbol IN LISTS config_variables)
        if(symbol MATCHES "^CONFIG_(MBEDTLS|PSA)_" AND NOT "${${symbol}}" STREQUAL "")
            string(JSON expected ERROR_VARIABLE missing GET "${contract}" crypto_config ${symbol})
            if(NOT missing STREQUAL "NOTFOUND")
                message(FATAL_ERROR "TiRTC crypto ABI mismatch: additional application setting ${symbol}")
            endif()
        endif()
    endforeach()
endfunction()
